# MongoDB (Atlas: Database -> Connect -> Drivers, or mongodb://localhost:27017 locally)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=lead-studio

# Signs session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
